{
  "kind": "collectionType",
  "collectionName": "projets",
  "info": {
    "singularName": "projet",
    "pluralName": "projets",
    "displayName": "Projet"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "text",
      "required": true
    },
    "genre": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::genre.genre",
      "inversedBy": "projets"
    },
    "beneficiaires": {
      "type": "text",
      "required": true
    },
    "localisation": {
      "type": "text",
      "required": true
    },
    "realisations_cles": {
      "type": "json",
      "required": true
    },
    "objectif_du_projet": {
      "type": "json",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "texte_du_projet": {
      "type": "richtext",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "statut": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::statut.statut",
      "inversedBy": "projets"
    },
    "periode": {
      "type": "text",
      "required": true
    }
  }
}
